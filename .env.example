# Copy this file to .env and fill in the values provided by your CTF organizer.
# In GitHub Codespaces, set these as Codespace Secrets instead of storing them here.

PORT=3000

# Flag values — provided by the organizer at the start of the event (opaque slot names)
FLAG1=
FLAG2=
FLAG3=
FLAG4=
FLAG5=
FLAG6=

# Internal GM verification token — provided by the organizer, do not modify
GM_TOKEN=
